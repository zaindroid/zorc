[Unit]
Description=servingz status page + approvals dashboard (localhost only)
After=network.target

[Service]
Type=simple
ExecStart=/home/zman/zorc/monitoring/.venv/bin/uvicorn server:app --host 127.0.0.1 --port 9999 --app-dir /home/zman/zorc/monitoring
WorkingDirectory=/home/zman/zorc/monitoring
User=zman
Restart=always
RestartSec=5

# Hardening — reads status files + registry.yaml + one secrets file, calls
# out to api.github.com. No writes at runtime.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true

[Install]
WantedBy=multi-user.target
