[Unit]
Description=servingz status page + approvals + deploy agent (localhost only)
After=network.target

[Service]
Type=simple
ExecStart=/home/zman/zorc/monitoring/.venv/bin/uvicorn server:app --host 127.0.0.1 --port 9999 --app-dir /home/zman/zorc/monitoring
WorkingDirectory=/home/zman/zorc/monitoring
User=zman
Restart=always
RestartSec=5

# Hardening -- reads status files + registry.yaml + secrets files, calls
# out to api.github.com/Coolify/Cloudflare APIs. The deploy agent needs
# real writes now (registry.yaml, cloudflared/config.yml, git commits,
# /etc/cloudflared via sudo, scratch dirs for clones/wrangler under /tmp)
# so ProtectHome stays read-only as the default but with explicit
# exceptions instead of turning protection off wholesale.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/zman/zorc /etc/cloudflared
PrivateTmp=true

[Install]
WantedBy=multi-user.target
